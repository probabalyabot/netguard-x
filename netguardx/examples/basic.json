    {"id": "P5", "action": "ALLOW", "source": "USER", "destination": "APP",    "protocol": "TCP", "port": 443},
    {"id": "P6", "action": "ALLOW", "source": "DB",   "destination": "BACKUP", "protocol": "TCP", "port": 873}
